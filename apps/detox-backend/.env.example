# ── Urban Detox Backend ──────────────────────────────────────
# Supabase Connection Pooler — Session Mode (port 5432)
DATABASE_URL=postgresql://postgres.<project>:<password>@<host>.pooler.supabase.com:5432/postgres

PORT=4000
NODE_ENV=development

# ── Supabase Keys ──────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Default Admin Account ────────────────────────────────────
ADMIN_EMAIL=hello@urbandetox.in
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# ── Resend Email ─────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=hello@urbandetox.in
RESEND_WEBHOOK_SECRET=your_resend_webhook_signing_secret

# ── Cloudflare R2 ────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=urbandetox
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-yourhash.r2.dev

# ── Google Reviews ───────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_api_key_here
GOOGLE_PLACE_ID=your_google_place_id_here

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=use_a_different_random_webhook_secret
# Required only when intentionally running Test Mode in a production build.
ALLOW_RAZORPAY_TEST_MODE=false

# ── Database SSL ──────────────────────────────────────────────
# Set to "true" if your database requires a valid CA-signed certificate.
# Supabase pooler uses self-signed certs — leave as false or unset.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ── API Security ──────────────────────────────────────────────
CORS_ORIGINS=https://beta.urbandetox.in,https://admin.urbandetox.in
# Local development:
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY_HOPS=1
