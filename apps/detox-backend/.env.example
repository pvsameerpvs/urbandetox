# ── Urban Detox Backend ──────────────────────────────────────
# Supabase Connection Pooler — Session Mode (port 5432)
DATABASE_URL=postgresql://postgres.<project>:<password>@<host>.pooler.supabase.com:5432/postgres

PORT=4000
NODE_ENV=development

# ── Supabase Keys ──────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Default Admin Account ────────────────────────────────────
ADMIN_EMAIL=hello@urbandetox.in
ADMIN_PASSWORD=admin@123

# ── Cloudflare R2 ────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=urbandetox-uploads
# Custom domain or public dev URL: https://pub-<hash>.r2.dev
R2_PUBLIC_URL=https://pub-yourhash.r2.dev
