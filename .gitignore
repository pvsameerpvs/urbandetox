# ─────────────────────────────────────────
# OS & Editor
# ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editor directories (keep shared settings in repo if needed)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace

# ─────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────
# Ignore ALL node_modules across the monorepo
**/node_modules/

# Package manager artifacts (keep lockfile!)
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─────────────────────────────────────────
# Logs & Debug
# ─────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─────────────────────────────────────────
# Environment / Secrets
# ─────────────────────────────────────────
.env
.env.*
apps/detox-backend/.env.test
!.env.example
!.env.template

# ─────────────────────────────────────────
# Next.js / Frontend Build Outputs
# ─────────────────────────────────────────
# Ignore ALL .next directories across apps
**/.next/
**/out/

# ─────────────────────────────────────────
# Backend Build Outputs
# ─────────────────────────────────────────
apps/detox-backend/dist/

# ─────────────────────────────────────────
# Shared Package Build Outputs
# ─────────────────────────────────────────
# tsup / tsc build outputs in packages
packages/**/dist/

# ─────────────────────────────────────────
# Turborepo / Turbo
# ─────────────────────────────────────────
.turbo/

# ─────────────────────────────────────────
# TypeScript
# ─────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─────────────────────────────────────────
# Testing
# ─────────────────────────────────────────
coverage/
.nyc_output/

# ─────────────────────────────────────────
# Deployment
# ─────────────────────────────────────────
.vercel
.netlify

# ─────────────────────────────────────────
# Misc
# ─────────────────────────────────────────
*.pem
.cache/
temp/
tmp/

# Local source assets (originals live here, published copies live in R2)
assets/
apps/temp/

# Local dev-server launch config (machine specific)
.claude/launch.json
